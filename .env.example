# Copia este fichero a .env en el servidor (junto a compose.yaml) y rellena los valores.
# .env NO se sube al repositorio (esta en .gitignore).
#
# OPO_TELEGRAM_TOKEN: el token que da @BotFather al crear el bot (123456789:AA...).
# OPO_TELEGRAM_CHAT_ID: tu chat_id, un NUMERO (no el @usuario). Lo consigues enviando
#   /start al bot y mirando https://api.telegram.org/bot<TOKEN>/getUpdates
OPO_TELEGRAM_TOKEN=
OPO_TELEGRAM_CHAT_ID=
